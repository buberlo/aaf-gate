{
  "template_id": "b2b-lead-research",
  "template_version": "0.3.0",
  "synthetic": true,
  "title": "Draft: B2B lead research without platform login",
  "fields": {
    "operator_name": {"access": "customer_editable", "type": "string", "required": true},
    "briefing_weekday": {
      "access": "customer_editable",
      "type": "string",
      "required": true,
      "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]
    },
    "results_storage": {"access": "customer_editable", "type": "string", "required": true},
    "control_channel": {
      "access": "locked",
      "type": "string",
      "required": true,
      "enum": ["telegram"]
    },
    "daily_limit_per_client": {"access": "customer_editable", "type": "integer", "required": true, "min": 1, "max": 10},
    "daily_limit_max": {"access": "locked", "type": "integer", "required": true, "min": 10, "max": 10},
    "request_char_limit_default": {"access": "customer_editable", "type": "integer", "required": true, "min": 1, "max": 300},
    "request_char_limit_max": {"access": "locked", "type": "integer", "required": true, "min": 300, "max": 300},
    "score_weights": {"access": "locked", "type": "string", "required": true},
    "activity_categories": {"access": "locked", "type": "array", "item_type": "string", "required": true},
    "allowed_source_types": {"access": "locked", "type": "array", "item_type": "string", "required": true},
    "blocked_domains": {
      "access": "locked",
      "type": "array",
      "item_type": "domain",
      "required": true,
      "min": 1,
      "contains": ["linkedin.com"]
    },
    "allow_platform_login": {"access": "fixed", "type": "boolean", "required": true, "value": false},
    "allow_unattended_send": {"access": "fixed", "type": "boolean", "required": true, "value": false},
    "require_source_per_claim": {"access": "locked", "type": "boolean", "required": true},
    "followup_requires_accept": {"access": "locked", "type": "boolean", "required": true},
    "objection_blocklist_enabled": {"access": "locked", "type": "boolean", "required": true},
    "telegram_pii_allowed": {"access": "locked", "type": "boolean", "required": true}
  }
}
